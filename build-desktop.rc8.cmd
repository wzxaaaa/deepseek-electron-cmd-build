@echo off
setlocal EnableExtensions
set "DSH_BOOTSTRAP=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$raw=[IO.File]::ReadAllText($env:DSH_BOOTSTRAP,[Text.Encoding]::ASCII);$marker='# POWERSHELL-BEGIN';$script=$raw.Substring($raw.LastIndexOf($marker)+$marker.Length);& ([scriptblock]::Create($script))"
set "EXIT_CODE=%ERRORLEVEL%"
if not "%EXIT_CODE%"=="0" (
  echo.
  echo Desktop build failed. Review the error above.
  if not defined DSH_NO_PAUSE pause
  exit /b %EXIT_CODE%
)
echo.
echo Desktop folder generated successfully.
echo See DeepSeek-Harness-Desktop\DeepSeek Harness.exe
if not defined DSH_NO_PAUSE pause
exit /b 0
# POWERSHELL-BEGIN
$ErrorActionPreference = 'Stop'
$root = Split-Path -Parent $env:DSH_BOOTSTRAP
while (-not (Test-Path -LiteralPath (Join-Path $root 'package.json'))) {
  $parent = Split-Path -Parent $root
  if ($parent -eq $root) { throw 'Could not find the repository root package.json.' }
  $root = $parent
}
Set-Location -LiteralPath $root
$pnpmVersion = '11.7.0'
$backupRoot = Join-Path $root ('.desktop-bootstrap-backup-' + [guid]::NewGuid().ToString('N'))

# Files the bootstrap CREATES (untracked in the harness repo) and files it
# TEMPORARILY PATCHES (tracked). Every one is backed up first and fully
# restored in the finally block, so the working tree is byte-identical and
# `git status` is clean once the build finishes. No harness source is left
# modified, and nothing is overwritten with a stale snapshot.
$createTargets = @('scripts/build-desktop.ts','desktop/runtime/package.json','desktop/shell/package.json','desktop/shell/main.cjs','desktop/shell/favicon.ico')
$patchTargets  = @('package.json','pnpm-workspace.yaml','pnpm-lock.yaml')
$targets = $createTargets + $patchTargets
$backupState = @{}

function Fail([string]$Message) { Write-Host "`nERROR: $Message" -ForegroundColor Red; throw $Message }

function Invoke-Pnpm([string[]]$Arguments) {
  if (Get-Command corepack -ErrorAction SilentlyContinue) { & corepack pnpm @Arguments }
  elseif (Get-Command pnpm -ErrorAction SilentlyContinue) { & pnpm @Arguments }
  else { & npx.cmd --yes "pnpm@$pnpmVersion" @Arguments }
  if ($LASTEXITCODE -ne 0) { throw "pnpm command failed with exit code $LASTEXITCODE" }
}

function Write-Payload([string]$RelativePath, [string]$Base64) {
  $target = Join-Path $root $RelativePath
  New-Item -ItemType Directory -Force -Path (Split-Path -Parent $target) | Out-Null
  [IO.File]::WriteAllBytes($target, [Convert]::FromBase64String($Base64))
}

# Insert one line immediately after the first line matching $AnchorRegex,
# unless $Guard already appears anywhere in the file. Additive and idempotent:
# it never rewrites existing lines, only adds the desktop overlay entry.
function Add-LineAfterAnchor([string]$RelativePath, [string]$AnchorRegex, [string]$NewLine, [string]$Guard) {
  $target = Join-Path $root $RelativePath
  $text = [IO.File]::ReadAllText($target)
  if ($text.Contains($Guard)) { return }
  $lines = [IO.File]::ReadAllLines($target)
  $out = New-Object 'System.Collections.Generic.List[string]'
  $inserted = $false
  foreach ($line in $lines) {
    [void]$out.Add($line)
    if (-not $inserted -and $line -match $AnchorRegex) { [void]$out.Add($NewLine); $inserted = $true }
  }
  if (-not $inserted) { throw "Could not find anchor /$AnchorRegex/ in $RelativePath" }
  [IO.File]::WriteAllLines($target, $out)
}

function Restore-Targets {
  foreach ($relative in $targets) {
    $target = Join-Path $root $relative
    $backup = Join-Path $backupRoot $relative
    if ($backupState[$relative] -eq $true) { Copy-Item -LiteralPath $backup -Destination $target -Force }
    elseif ($backupState.ContainsKey($relative)) { Remove-Item -LiteralPath $target -Force -ErrorAction SilentlyContinue }
  }
}

try {
  if ($env:OS -ne 'Windows_NT') { Fail 'Windows is required.' }
  if (-not [Environment]::Is64BitOperatingSystem) { Fail '64-bit Windows is required.' }
  if (-not (Get-Command node -ErrorAction SilentlyContinue)) { Fail 'Install Node.js 22.19+ or 24+ first.' }
  $nodeRaw = (& node --version 2>$null).Trim()
  if ($nodeRaw -notmatch '^v(?<v>\d+\.\d+\.\d+)$') { Fail 'Could not read Node.js version.' }
  $nodeVersion = [version]$Matches.v
  if (-not (($nodeVersion.Major -eq 22 -and $nodeVersion -ge [version]'22.19.0') -or $nodeVersion.Major -ge 24)) { Fail "Unsupported Node.js version $nodeVersion. Required: 22.19+ or 24+." }
  if (-not (Get-Command npm -ErrorAction SilentlyContinue)) { Fail 'npm is required with Node.js.' }
  $env:CI = 'true'
  Write-Host "Repository: $root" -ForegroundColor Green
  Write-Host "Node.js $nodeVersion detected." -ForegroundColor Green
  New-Item -ItemType Directory -Force -Path $backupRoot | Out-Null
  foreach ($relative in $targets) {
    $target = Join-Path $root $relative
    $backup = Join-Path $backupRoot $relative
    if (Test-Path -LiteralPath $target) {
      New-Item -ItemType Directory -Force -Path (Split-Path -Parent $backup) | Out-Null
      Copy-Item -LiteralPath $target -Destination $backup -Force
      $backupState[$relative] = $true
    } else { $backupState[$relative] = $false }
  }
  $payload = @{
    'scripts/build-desktop.ts' = ''
    'desktop/runtime/package.json' = ''
    'desktop/shell/package.json' = ''
    'desktop/shell/main.cjs' = ''
    'desktop/shell/favicon.ico' = ''
  }
  foreach ($entry in $payload.GetEnumerator()) { Write-Payload $entry.Key $entry.Value }
  # Additive, idempotent overlay of the three tracked config files.
  Add-LineAfterAnchor 'package.json' '"workspaces"\s*:\s*\[' '    "desktop/runtime",' '"desktop/runtime"'
  Add-LineAfterAnchor 'package.json' '"devDependencies"\s*:\s*\{' '    "@electron/packager": "20.3.0",' '@electron/packager'
  Add-LineAfterAnchor 'pnpm-workspace.yaml' '^packages:' '  - desktop/runtime' 'desktop/runtime'
  Write-Host '[1/2] Installing dependencies for the desktop build (lockfile is updated in place, then restored)...'
  Invoke-Pnpm @('install','--no-frozen-lockfile')
  if ($env:DSH_BOOTSTRAP_VERIFY_ONLY -eq '1') {
    Write-Host 'Verifying the desktop runtime dependency closure against the current harness...' -ForegroundColor Cyan
    Invoke-Pnpm @('exec','tsx','scripts/verify-runtime-closure.ts','--manifest','desktop/runtime/package.json')
    Write-Host 'Runtime closure verification passed.' -ForegroundColor Green
    exit 0
  }
  Write-Host '[2/2] Building and testing the Windows desktop folder...'
  Invoke-Pnpm @('exec','tsx','scripts/build-desktop.ts')
  Write-Host "`nDesktop build complete:" -ForegroundColor Green
  Write-Host (Join-Path $root 'DeepSeek-Harness-Desktop\DeepSeek Harness.exe') -ForegroundColor Green
} catch { Write-Host "`nDesktop build failed: $($_.Exception.Message)" -ForegroundColor Red; exit 1 }
finally { Restore-Targets; Remove-Item -LiteralPath $backupRoot -Recurse -Force -ErrorAction SilentlyContinue }
